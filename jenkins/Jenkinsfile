pipeline {
    agent { label 'yocto-linux' }

    options {
        timestamps()
        disableConcurrentBuilds()
        durabilityHint('MAX_SURVIVABILITY')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    // Intentionally no SCM polling here.
    // Preferred model: manual bring-up now, webhook or scheduled Jenkins trigger later.

    parameters {
        booleanParam(name: 'BUILD_CONTAINER_IMAGE', defaultValue: true, description: 'Build or refresh the local Yocto container image before running the build')
        booleanParam(name: 'RUN_BUILD', defaultValue: true, description: 'Run the Yocto build stage inside the container')
        booleanParam(name: 'VERIFY_STM32_TOOLS', defaultValue: true, description: 'Verify STM32 CLI tooling inside the container image when STM32CubeProgrammer content is supplied')
        booleanParam(name: 'ARCHIVE_OUTPUTS', defaultValue: true, description: 'Archive out/ artifacts at the end')
    }

    environment {
        LC_ALL = 'C.UTF-8'
        LANG = 'C.UTF-8'
        CONTAINER_PROFILE = 'ubuntu2404'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git status --short || true'
                sh 'git log -1 --oneline'
            }
        }

        stage('Host validation') {
            parallel {
                stage('Container tooling') {
                    steps {
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail
                            command -v docker
                            docker version
                        '''
                    }
                }
                stage('Config') {
                    steps {
                        sh 'test -f config/build.env'
                        sh 'test -f jenkins/Jenkinsfile'
                        sh 'test -f containers/stm32mp-yocto/Dockerfile'
                        sh 'test -x scripts/build-container-image.sh'
                        sh 'test -x scripts/run-container-build.sh'
                    }
                }
            }
        }

        stage('Source bootstrap') {
            steps {
                sh './scripts/bootstrap-manifest.sh'
            }
        }

        stage('Prepare shared cache access') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    source ./config/build.env
                    echo "Preparing Git trust for shared Yocto cache"
                    git config --global --replace-all safe.directory '*'
                    git config --global --get-all safe.directory || true
                    mkdir -p "$DL_DIR" "$SSTATE_DIR" out
                '''
            }
        }

        stage('Build container image') {
            when {
                expression { return params.BUILD_CONTAINER_IMAGE }
            }
            steps {
                sh './scripts/build-container-image.sh'
            }
        }

        stage('Verify STM32 CLI tools in container') {
            when {
                expression { return params.VERIFY_STM32_TOOLS }
            }
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    if [ -n "${STM32CUBEPROG_DIR:-}" ] || [ -n "${STM32CUBEPROG_BUNDLE:-}" ]; then
                        docker run --rm \
                            --hostname ubuntu24 \
                            -e LOCAL_UID="$(id -u)" \
                            -e LOCAL_GID="$(id -g)" \
                            -e LOCAL_USER="$(id -un)" \
                            -e LOCAL_GROUP="$(id -gn)" \
                            -e WORKSPACE_DIR=/workspace \
                            -v "$PWD":/workspace \
                            stm32mp-yocto-toolbox:local \
                            ./scripts/verify-stm32-cli-tools.sh
                    else
                        echo "STM32CubeProgrammer content not supplied; skipping STM32 CLI verification."
                    fi
                '''
            }
        }

        stage('Build') {
            when {
                expression { return params.RUN_BUILD }
            }
            steps {
                sh './scripts/run-container-build.sh'
            }
        }

        stage('Archive outputs') {
            when {
                expression { return params.ARCHIVE_OUTPUTS }
            }
            steps {
                sh './scripts/archive-artifacts.sh'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'out/**/*', fingerprint: true, allowEmptyArchive: true
        }
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Inspect console output and archived artifacts.'
        }
    }
}
