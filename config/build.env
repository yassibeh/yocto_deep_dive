# shellcheck shell=sh

# Official ST OpenSTLinux manifest
ST_MANIFEST_URL="https://github.com/STMicroelectronics/oe-manifest.git"
ST_MANIFEST_TAG="openstlinux-6.6-yocto-scarthgap-mpu-v25.04.30"

# Workspace layout
PROJECT_ROOT="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || pwd)"
MANIFEST_DIR="${PROJECT_ROOT}/sources"
OUT_DIR="${PROJECT_ROOT}/out"

# Target configuration
MACHINE="stm32mp13-disco"
DISTRO="openstlinux-weston"
YOCTO_IMAGE="core-image-minimal"

BUILD_DIR_NAME="build-${DISTRO}-${MACHINE}"
ST_BUILD_DIR="${MANIFEST_DIR}/${BUILD_DIR_NAME}"

# Shared Yocto cache configuration
# Override these in the environment or in a local untracked config if needed.
SHARED_CACHE_ROOT="${SHARED_CACHE_ROOT:-${PROJECT_ROOT}/.yocto-cache}"
DL_DIR="${DL_DIR:-${SHARED_CACHE_ROOT}/downloads}"
SSTATE_DIR="${SSTATE_DIR:-${SHARED_CACHE_ROOT}/sstate-cache}"

# These are only used to let ST generate site.conf during envsetup.
# We then rewrite site.conf to the effective cache paths above.
FORCE_DL_CACHEPREFIX="${FORCE_DL_CACHEPREFIX:-${SHARED_CACHE_ROOT}}"
FORCE_SSTATE_CACHEPREFIX="${FORCE_SSTATE_CACHEPREFIX:-${SHARED_CACHE_ROOT}}"

# ST EULA handling for non-interactive CI/builds
# Set to 0 if you want the upstream scripts to prompt interactively instead.
ST_AUTO_ACCEPT_EULA="${ST_AUTO_ACCEPT_EULA:-1}"

# Parallelism
BB_NUMBER_THREADS="$(nproc)"
PARALLEL_MAKE="-j$(nproc)"

# Artifact handling
ARTIFACT_IMAGE_GLOB="${ST_BUILD_DIR}/tmp/deploy/images/${MACHINE}/*"
